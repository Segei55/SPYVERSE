{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.spyverse.desktop",
  "productName": "SPYVERSE",
  "publish": {
    "provider": "github",
    "owner": "Segei55",
    "repo": "SPYVERSE",
    "releaseType": "release"
  },
  "icon": "icon.png",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "apps/desktop/dist/**/*"
  ],
  "win": {
    "extraFiles": [
      {
        "from": "server.bat",
        "to": "server.bat"
      },
      {
        "from": "dist-server/spyverse-server.cjs",
        "to": "spyverse-server.cjs"
      },
      {
        "from": "dist",
        "to": "dist",
        "filter": ["**/*"]
      }
    ],
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SPYVERSE"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Game"
  }
}

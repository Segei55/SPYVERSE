{
  "name": "spyverse",
  "description": "SPYVERSE — многоплатформенная шпионская игра для компании друзей",
  "author": {
    "name": "SPYVERSE",
    "email": "spyverse@example.com"
  },
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "main": "apps/desktop/dist/main.cjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "npx --yes tsx --test packages/game-engine/src/__tests__/game.test.ts packages/game-engine/src/__tests__/content.test.ts src/utils/__tests__/releases.test.ts",
    "start:server": "tsx apps/server/src/standalone.ts",
    "build:server": "esbuild apps/server/src/standalone.ts --bundle --platform=node --target=node20 --outfile=dist-server/spyverse-server.cjs",
    "build:desktop": "npm run build:server && npm run build && npm run build -w @spyverse/desktop && electron-builder --config apps/desktop/electron-builder.json --dir",
    "build:mobile": "npm run build && npm run sync -w @spyverse/mobile && npm run set:android-version && npm run generate:android-icons",
    "set:android-version": "node scripts/set-android-version.mjs",
    "generate:android-icons": "node scripts/generate-android-icons.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
